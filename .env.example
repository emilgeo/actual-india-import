# Real environment variables take precedence over this file, so a one-off
# override still works:
#
#   ACTUAL_SYNC_ID=other-budget npx tsx src/cli.ts statement.pdf --push ...
#
# None of this is needed to convert a statement to CSV.

# --- Encrypted statement PDFs ------------------------------------------------
STATEMENT_PASSWORD=

# --- Pushing into Actual (--push) --------------------------------------------
# Your Actual sync server, and the password used to sign in to it
ACTUAL_SERVER_URL=
ACTUAL_PASSWORD=

# The budget to import into: Settings > Advanced > Sync ID
ACTUAL_SYNC_ID=

# Only if this budget uses end-to-end encryption
ACTUAL_ENCRYPTION_PASSWORD=

# Where the API keeps its local copy of the budget. Defaults to ./.actual-cache
ACTUAL_DATA_DIR=
